 	brcmf_dbg(PCIE, "Enter, dev=%p, bus=%p\n", dev, bus);
 
 	/*
+	 * This board can retain a nonzero interrupt mask while its firmware
+	 * no longer answers commands after s2idle. Use the existing cold
