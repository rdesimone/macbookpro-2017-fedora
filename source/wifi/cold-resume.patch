+	 */
+	if (devinfo->ci && devinfo->ci->chip == BRCM_CC_43602_CHIP_ID &&
+	    devinfo->pdev->subsystem_vendor == PCI_VENDOR_ID_APPLE &&
+	    devinfo->pdev->subsystem_device == 0x0157 &&
+	    dmi_match(DMI_PRODUCT_NAME, "MacBookPro14,2")) {
+		brcmf_info("MacBookPro14,2: reinitializing BCM43602 after resume\n");
+		/* Teardown accesses PCIe registers; retain the correct window. */
+		brcmf_pcie_select_core(devinfo, BCMA_CORE_PCIE2);
+		goto cleanup;
+	}
